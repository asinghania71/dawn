{% comment %}
  This section stores the ribbon badge configuration.
  It is consumed by snippets/product-ribbons.liquid via sections['product-ribbons-config'].
  No JavaScript output is needed — all evaluation happens server-side in Liquid.
{% endcomment %}

{% schema %}
{
  "name": "t:sections.product-ribbons-config.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.product-ribbons-config.settings.paragraph.content"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:sections.product-ribbons-config.settings.position.label",
      "options": [
        { "value": "top-left", "label": "t:sections.product-ribbons-config.settings.position.options.top-left" },
        { "value": "top-right", "label": "t:sections.product-ribbons-config.settings.position.options.top-right" },
        { "value": "bottom-left", "label": "t:sections.product-ribbons-config.settings.position.options.bottom-left" },
        { "value": "bottom-right", "label": "t:sections.product-ribbons-config.settings.position.options.bottom-right" }
      ],
      "default": "top-left"
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:sections.product-ribbons-config.settings.size.label",
      "options": [
        { "value": "small", "label": "t:sections.product-ribbons-config.settings.size.options.small" },
        { "value": "medium", "label": "t:sections.product-ribbons-config.settings.size.options.medium" },
        { "value": "large", "label": "t:sections.product-ribbons-config.settings.size.options.large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "t:sections.product-ribbons-config.blocks.badge.name",
      "settings": [
        {
          "type": "select",
          "id": "data_source",
          "label": "t:sections.product-ribbons-config.blocks.badge.settings.data_source.label",
          "options": [
            { "value": "tag", "label": "t:sections.product-ribbons-config.blocks.badge.settings.data_source.options.tag" },
            { "value": "rating", "label": "t:sections.product-ribbons-config.blocks.badge.settings.data_source.options.rating" },
            { "value": "inventory", "label": "t:sections.product-ribbons-config.blocks.badge.settings.data_source.options.inventory" },
            { "value": "price_sale", "label": "t:sections.product-ribbons-config.blocks.badge.settings.data_source.options.price_sale" },
            { "value": "vendor", "label": "t:sections.product-ribbons-config.blocks.badge.settings.data_source.options.vendor" },
            { "value": "type", "label": "t:sections.product-ribbons-config.blocks.badge.settings.data_source.options.type" },
            { "value": "title", "label": "t:sections.product-ribbons-config.blocks.badge.settings.data_source.options.title" },
            { "value": "age", "label": "t:sections.product-ribbons-config.blocks.badge.settings.data_source.options.age" }
          ],
          "default": "tag"
        },
        {
          "type": "select",
          "id": "operator",
          "label": "t:sections.product-ribbons-config.blocks.badge.settings.operator.label",
          "options": [
            { "value": "equals", "label": "t:sections.product-ribbons-config.blocks.badge.settings.operator.options.equals" },
            { "value": "not_equals", "label": "t:sections.product-ribbons-config.blocks.badge.settings.operator.options.not_equals" },
            { "value": "greater_than", "label": "t:sections.product-ribbons-config.blocks.badge.settings.operator.options.greater_than" },
            { "value": "less_than", "label": "t:sections.product-ribbons-config.blocks.badge.settings.operator.options.less_than" },
            { "value": "contains", "label": "t:sections.product-ribbons-config.blocks.badge.settings.operator.options.contains" }
          ],
          "default": "equals"
        },
        {
          "type": "text",
          "id": "compare_value",
          "label": "t:sections.product-ribbons-config.blocks.badge.settings.compare_value.label",
          "info": "t:sections.product-ribbons-config.blocks.badge.settings.compare_value.info",
          "default": "badge:bestseller"
        },
        {
          "type": "text",
          "id": "display_text",
          "label": "t:sections.product-ribbons-config.blocks.badge.settings.display_text.label",
          "default": "Best Seller"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "t:sections.product-ribbons-config.blocks.badge.settings.background_color.label",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "t:sections.product-ribbons-config.blocks.badge.settings.text_color.label",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "opacity",
          "min": 10,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "t:sections.product-ribbons-config.blocks.badge.settings.opacity.label",
          "default": 100
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.product-ribbons-config.presets.name"
    }
  ]
}
{% endschema %}
