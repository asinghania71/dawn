<script>
  window.productRibbonsConfig = {
    position: {{ section.settings.position | json }},
    size: {{ section.settings.size | json }},
    badges: [
      {%- for block in section.blocks -%}
        {
          dataSource: {{ block.settings.data_source | json }},
          operator: {{ block.settings.operator | json }},
          compareValue: {{ block.settings.compare_value | downcase | json }},
          text: {{ block.settings.display_text | json }},
          backgroundColor: {{ block.settings.background_color | json }},
          textColor: {{ block.settings.text_color | json }},
          opacity: {{ block.settings.opacity | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  };
</script>

{% schema %}
{
  "name": "Product Ribbons Config",
  "settings": [
    {
      "type": "paragraph",
      "content": "This section powers the global Web Component for product ribbon badges. Add this section once to your Footer Group to enable global badge logic."
    },
    {
      "type": "select",
      "id": "position",
      "label": "Ribbon Position",
      "options": [
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "default": "top-left"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Ribbon Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Ribbon Badge",
      "settings": [
        {
          "type": "select",
          "id": "data_source",
          "label": "Data Source",
          "options": [
            { "value": "tag", "label": "Product Tag" },
            { "value": "metafield", "label": "custom.badge Metafield" },
            { "value": "rating", "label": "Product Rating" },
            { "value": "inventory", "label": "Inventory Quantity" },
            { "value": "price_sale", "label": "On Sale (Compare At > Price)" },
            { "value": "vendor", "label": "Vendor" },
            { "value": "type", "label": "Type" },
            { "value": "title", "label": "Title" },
            { "value": "age", "label": "Age (Days since created)" }
          ],
          "default": "tag"
        },
        {
          "type": "select",
          "id": "operator",
          "label": "Operator",
          "options": [
            { "value": "equals", "label": "Equals (==)" },
            { "value": "not_equals", "label": "Not Equals (!=)" },
            { "value": "greater_than", "label": "Greater Than (>)" },
            { "value": "less_than", "label": "Less Than (<)" },
            { "value": "contains", "label": "Contains" }
          ],
          "default": "equals"
        },
        {
          "type": "text",
          "id": "compare_value",
          "label": "Compare Value",
          "info": "The value to evaluate against. Leave blank for boolean checks like 'On Sale'.",
          "default": "badge:bestseller"
        },
        {
          "type": "text",
          "id": "display_text",
          "label": "Display Text",
          "default": "Best Seller"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "opacity",
          "min": 10,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "Ribbon Opacity",
          "default": 100
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Ribbons Config"
    }
  ]
}
{% endschema %}
