{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'shoppable-shorts.css' | asset_url | stylesheet_tag }}

<script src="{{ 'shoppable-shorts.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="collection shoppable-shorts section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}">
    
    {% render 'section-heading',
      title: section.settings.title,
      heading_size: section.settings.heading_size,
      heading_alignment: section.settings.heading_alignment,
      description: section.settings.description,
      description_style: section.settings.description_style,
      description_alignment: section.settings.heading_alignment,
      wrapper_classes: 'collection__title page-width'
    %}

    <slider-component class="slider-mobile-gutter{% if section.settings.full_width %} slider-component-full-width{% endif %}{% unless section.settings.full_width %} page-width{% endunless %}">
      <ul id="Slider-{{ section.id }}" class="grid product-grid contains-card grid--{{ section.settings.columns_desktop }}-col-desktop {% if section.settings.columns_mobile == '2' %}grid--2-col-tablet-down{% else %}grid--1-col-tablet-down{% endif %} slider slider--tablet slider--desktop {% if section.settings.columns_mobile == '1_90' %}grid--peek shoppable-shorts--mobile-90{% endif %}" role="list" aria-label="{{ 'general.slider.name' | t }}">
        {%- for block in section.blocks -%}
          <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="grid__item slider__slide" {{ block.shopify_attributes }}>
            <shoppable-short 
              data-url="{{ block.settings.video_url }}" 
              data-autoplay="{{ section.settings.enable_autoplay }}"
              data-has-poster="{% if block.settings.poster_image != blank %}true{% else %}false{% endif %}"
            >
              <div class="shoppable-short-card shoppable-short-card--ratio-{{ section.settings.video_ratio }} color-{{ section.settings.card_color_scheme }}"
                {% if section.settings.video_ratio == 'adapt' and block.settings.poster_image != blank %}
                  style="padding-bottom: {{ 100 | divided_by: block.settings.poster_image.aspect_ratio }}%;"
                {% endif %}
              >
                <div class="shoppable-short-card__poster" role="button" tabindex="0" aria-label="{{ 'general.play_video' | t | default: 'Play video' }}">
                  {%- if block.settings.poster_image != blank -%}
                    {{ block.settings.poster_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
                  {%- else -%}
                    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                  {%- endif -%}
                  
                  <div class="shoppable-short-card__play-icon">
                    {{- 'icon-play.svg' | inline_asset_content -}}
                  </div>
                </div>

                <div class="shoppable-short-card__iframe-wrapper"></div>
                
                {%- if block.settings.linked_product != blank -%}
                  {%- assign product = block.settings.linked_product -%}
                  <div class="shoppable-short-card__product-banner color-{{ section.settings.button_color_scheme }}">
                    <a href="{{ product.url }}" class="shoppable-short-card__banner-link">
                      <div class="shoppable-short-card__banner-image shoppable-short-card__banner-image--{{ section.settings.image_ratio }}">
                        {%- if product.featured_image != blank -%}
                          {{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy' }}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                      </div>
                      <div class="shoppable-short-card__banner-info">
                        <span class="shoppable-short-card__banner-title">{{ product.title | truncate: 30 }}</span>
                        <span class="shoppable-short-card__banner-action">
                          {%- if block.settings.button_label != blank -%}
                            {{ block.settings.button_label }}
                          {%- else -%}
                            Shop Now
                          {%- endif -%}
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                      </div>
                      
                      {%- assign rating = product.metafields.reviews.rating.value -%}
                      {%- if rating != blank and settings.enable_review_widget -%}
                        <div class="shoppable-short-card__banner-rating">
                          {% render 'review-widget', product: product, show_review_widget: section.settings.show_review_widget, review_widget_size: section.settings.review_widget_size, color_scheme: section.settings.rating_color_scheme %}
                        </div>
                      {%- endif -%}
                    </a>
                  </div>
                {%- endif -%}

              </div>
            </shoppable-short>
          </li>
        {%- endfor -%}
      </ul>

      <div class="slider-buttons no-js-hidden">
        <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}">
          {{ 'icon-caret.svg' | inline_asset_content }}
        </button>
        <div class="slider-counter caption">
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ section.blocks.size }}</span>
        </div>
        <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}">
          {{ 'icon-caret.svg' | inline_asset_content }}
        </button>
      </div>
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.shoppable-shorts.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Shop our feed",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.heading_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.heading_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.heading_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.heading_alignment.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "t:sections.featured-collection.settings.description_style.label",
      "options": [
        {
          "value": "body",
          "label": "t:sections.featured-collection.settings.description_style.options__1.label"
        },
        {
          "value": "subtitle",
          "label": "t:sections.featured-collection.settings.description_style.options__2.label"
        },
        {
          "value": "uppercase",
          "label": "t:sections.featured-collection.settings.description_style.options__3.label"
        }
      ],
      "default": "body"
    },
    {
      "type": "header",
      "content": "t:sections.shoppable-shorts.headers.video.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.shoppable-shorts.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1_90",
      "label": "t:sections.shoppable-shorts.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.shoppable-shorts.settings.columns_mobile.options__1.label"
        },
        {
          "value": "1_90",
          "label": "t:sections.shoppable-shorts.settings.columns_mobile.options__1_90.label"
        },
        {
          "value": "2",
          "label": "t:sections.shoppable-shorts.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "video_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.featured-collection.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.featured-collection.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.featured-collection.settings.image_ratio.options__3.label"
        }
      ],
      "default": "portrait",
      "label": "t:sections.shoppable-shorts.settings.video_ratio.label",
      "info": "t:sections.shoppable-shorts.settings.video_ratio.info"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.featured-collection.settings.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:sections.shoppable-shorts.settings.enable_autoplay.label",
      "info": "t:sections.shoppable-shorts.settings.enable_autoplay.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.shoppable-shorts.headers.product_banner.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "square",
          "label": "t:sections.featured-collection.settings.image_ratio.options__3.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.featured-collection.settings.image_ratio.options__2.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.featured-collection.settings.image_ratio.options__1.label"
        }
      ],
      "default": "square",
      "label": "t:sections.shoppable-shorts.settings.image_ratio.label",
      "info": "t:sections.shoppable-shorts.settings.image_ratio.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "button_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "color_scheme",
      "id": "rating_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Review Widget"
    },
    {
      "type": "checkbox",
      "id": "show_review_widget",
      "default": true,
      "label": "t:sections.main-product.blocks.price.settings.show_discount_badge.label" 
    },
    {
      "type": "select",
      "id": "review_widget_size",
      "options": [
        { "value": "small", "label": "t:sections.main-product.blocks.sku.settings.text_style.options__1.label" },
        { "value": "medium", "label": "t:sections.main-product.blocks.sku.settings.text_style.options__2.label" },
        { "value": "large", "label": "t:sections.main-product.blocks.sku.settings.text_style.options__3.label" }
      ],
      "default": "medium",
      "label": "t:sections.main-product.blocks.text.settings.text_style.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "video_short",
      "name": "t:sections.shoppable-shorts.blocks.video_short.name",
      "settings": [
        {
          "type": "text",
          "id": "video_url",
          "label": "t:sections.shoppable-shorts.blocks.video_short.settings.video_url.label",
          "info": "t:sections.shoppable-shorts.blocks.video_short.settings.video_url.info"
        },
        {
          "type": "image_picker",
          "id": "poster_image",
          "label": "t:sections.shoppable-shorts.blocks.video_short.settings.poster_image.label",
          "info": "t:sections.shoppable-shorts.blocks.video_short.settings.poster_image.info"
        },
        {
          "type": "product",
          "id": "linked_product",
          "label": "t:sections.shoppable-shorts.blocks.video_short.settings.linked_product.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.shoppable-shorts.blocks.video_short.settings.button_label.label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shoppable-shorts.presets.name",
      "blocks": [
        {
          "type": "video_short"
        },
        {
          "type": "video_short"
        },
        {
          "type": "video_short"
        },
        {
          "type": "video_short"
        }
      ]
    }
  ]
}
{% endschema %}
