{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- if section.settings.quick_add != 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- unless request.design_mode -%}
    .recently-viewed-section:not(.is-active) {
      display: none !important;
    }
  {%- endunless -%}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient recently-viewed-section" id="recently-viewed-wrapper-{{ section.id }}">
  <div class="collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}">
    {% render 'section-heading',
      title: section.settings.title,
      heading_size: section.settings.heading_size,
      heading_alignment: section.settings.heading_alignment,
      description: section.settings.description,
      description_style: section.settings.description_style,
      description_alignment: section.settings.description_alignment,
      wrapper_classes: 'collection__title page-width'
    %}

    <recently-viewed-products class="recently-viewed-products" data-section-id="{{ section.id }}" data-limit="{{ section.settings.products_to_show }}">
      {% render 'product-slider', products: search.results, limit: section.settings.products_to_show, show_review_widget: section.settings.show_review_widget, review_widget_size: section.settings.review_widget_size, ribbon_size: section.settings.ribbon_size %}
    </recently-viewed-products>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.recently-viewed.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
