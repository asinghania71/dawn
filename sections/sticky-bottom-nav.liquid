{{ 'component-sticky-bottom-nav.css' | asset_url | stylesheet_tag }}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.body.classList.add('has-sticky-bottom-nav');
    
    // Highlight Active Link
    const currentPath = window.location.pathname + window.location.search;
    const navItems = document.querySelectorAll('.sticky-bottom-nav__item');
    navItems.forEach(item => {
      const href = item.getAttribute('href');
      // Exact match for SPA accuracy
      if (href === currentPath) {
        item.classList.add('is-active');
      }
    });

    // SPA Behaviors
    navItems.forEach(item => {
      item.addEventListener('click', (e) => {
        const actionType = item.dataset.action;
        if (actionType === 'cart') {
          e.preventDefault();
          const cartIcon = document.getElementById('cart-icon-bubble');
          if (cartIcon) cartIcon.click();
        } else if (actionType === 'search') {
          e.preventDefault();
          const searchIcon = document.querySelector('details-modal.header__search summary');
          if (searchIcon) searchIcon.click();
        } else if (actionType === 'wishlist') {
          e.preventDefault();
          window.dispatchEvent(new Event('wishlist:open'));
        }
      });
    });
  });
</script>

<nav class="sticky-bottom-nav sticky-bottom-nav--{{ section.settings.size }} sticky-bottom-nav--{{ section.settings.design_style }} color-{{ section.settings.color_scheme }} gradient">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.url | default: '#' }}" class="sticky-bottom-nav__item" data-action="{{ block.settings.action_type }}" {{ block.shopify_attributes }}>
      {%- if block.settings.custom_icon != blank -%}
        <div class="sticky-bottom-nav__icon-wrapper">
          {{ block.settings.custom_icon | image_url: width: 48 | image_tag: style: 'max-width: 100%; height: auto; object-fit: contain;' }}
        </div>
      {%- else -%}
        <div class="sticky-bottom-nav__icon-wrapper">
          {%- capture svg_filename -%}icon-{{ block.settings.icon }}.svg{%- endcapture -%}
          {{- svg_filename | inline_asset_content -}}
        </div>
      {%- endif -%}
      <span class="sticky-bottom-nav__text">{{ block.settings.text }}</span>
    </a>
  {%- endfor -%}
</nav>

