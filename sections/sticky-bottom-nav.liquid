{{ 'component-sticky-bottom-nav.css' | asset_url | stylesheet_tag }}

<style>
  body { --sticky-bottom-nav-height: {% if section.settings.size == 'small' %}5.2rem{% elsif section.settings.size == 'large' %}7.2rem{% else %}6.2rem{% endif %}; }
  body { padding-bottom: var(--sticky-bottom-nav-height); }
  @media screen and (min-width: 990px) { body { padding-bottom: 0; } }
</style>

<script>
  if (!customElements.get('sticky-bottom-nav')) {
    customElements.define('sticky-bottom-nav', class StickyBottomNav extends HTMLElement {
      constructor() {
        super();
        this.nav = this.querySelector('nav');
        this.behavior = this.getAttribute('data-behavior');
        this.currentScrollTop = 0;
        
        if (this.behavior !== 'always') {
          window.addEventListener('scroll', this.onScroll.bind(this), { passive: true });
        }
        
        this.initSPA();
      }
      
      onScroll() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        
        if (this.behavior === 'on-scroll-up') {
          if (scrollTop > this.currentScrollTop && scrollTop > 150) {
            this.nav.classList.add('is-hidden');
          } else {
            this.nav.classList.remove('is-hidden');
          }
        } else if (this.behavior === 'reduce-on-scroll') {
          if (scrollTop > 100) {
            this.nav.classList.add('is-reduced');
          } else {
            this.nav.classList.remove('is-reduced');
          }
        }
        
        this.currentScrollTop = scrollTop;
      }
      
      initSPA() {
        const navItems = this.querySelectorAll('.sticky-bottom-nav__item');
        navItems.forEach(item => {
          item.addEventListener('click', (e) => {
            const actionType = item.dataset.action;
            if (actionType === 'cart') {
              e.preventDefault();
              const cartIcon = document.getElementById('cart-icon-bubble');
              if (cartIcon) cartIcon.click();
            } else if (actionType === 'search') {
              e.preventDefault();
              const searchModals = document.querySelectorAll('details-modal.header__search details');
              searchModals.forEach(modal => {
                if (modal.parentElement.offsetParent !== null) {
                  modal.setAttribute('open', 'true');
                  const summary = modal.querySelector('summary');
                  if (summary) summary.setAttribute('aria-expanded', 'true');
                  const input = modal.querySelector('input');
                  if (input) setTimeout(() => input.focus(), 100);
                }
              });
            } else if (actionType === 'wishlist') {
              e.preventDefault();
              window.dispatchEvent(new Event('wishlist:open'));
            }
          });
        });
      }
    });
  }
</script>

<sticky-bottom-nav data-behavior="{{ section.settings.sticky_behavior }}">
  <nav class="sticky-bottom-nav sticky-bottom-nav--{{ section.settings.size }} sticky-bottom-nav--{{ section.settings.design_style }} color-{{ section.settings.color_scheme }} gradient" aria-label="{{ 'general.mobile_menu' | t | default: 'Mobile navigation' }}">
  {%- for block in section.blocks -%}
    {%- assign is_nav_active = false -%}
    {%- if block.settings.action_type == 'link' and block.settings.url != blank -%}
      {%- assign link_path = block.settings.url | split: '?' | first -%}
      {%- if request.path == link_path -%}
        {%- assign is_nav_active = true -%}
      {%- endif -%}
    {%- endif -%}
    {%- if block.settings.action_type == 'link' -%}
      <a href="{{ block.settings.url | default: '#' }}" class="sticky-bottom-nav__item{% if is_nav_active %} is-active{% endif %}" data-action="{{ block.settings.action_type }}" {{ block.shopify_attributes }}>
    {%- else -%}
      <button type="button" class="sticky-bottom-nav__item{% if is_nav_active %} is-active{% endif %}" data-action="{{ block.settings.action_type }}" {{ block.shopify_attributes }}>
    {%- endif -%}
      {%- if block.settings.custom_icon != blank -%}
        <div class="sticky-bottom-nav__icon-wrapper">
          {{ block.settings.custom_icon | image_url: width: 48 | image_tag: style: 'max-width: 100%; height: auto; object-fit: contain;', alt: block.settings.text }}
        </div>
      {%- else -%}
        <div class="sticky-bottom-nav__icon-wrapper">
          {%- capture svg_filename -%}icon-{{ block.settings.icon }}.svg{%- endcapture -%}
          {{- svg_filename | inline_asset_content -}}
        </div>
      {%- endif -%}
      <span class="sticky-bottom-nav__text">{{ block.settings.text }}</span>
    {%- if block.settings.action_type == 'link' -%}
      </a>
    {%- else -%}
      </button>
    {%- endif -%}
  {%- endfor -%}
</nav>
</sticky-bottom-nav>

