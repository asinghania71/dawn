{{ 'component-trust-badges-bar.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.icon_color != blank -%}
    #TrustBadges-{{ section.id }} {
      --trust-badge-icon-color: {{ section.settings.icon_color }};
    }
  {%- endif -%}
{%- endstyle -%}

<div id="TrustBadges-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient trust-badges-bar{% if section.settings.show_dividers %} trust-badges-bar--show-dividers{% endif %}">
  <div class="section-{{ section.id }}-padding{% if section.settings.full_width %} trust-badges-bar--full-width{% else %} page-width{% endif %}">
    
    {%- if section.settings.title != blank -%}
      {% render 'section-heading', title: section.settings.title, heading_size: section.settings.heading_size, heading_alignment: section.settings.heading_alignment %}
    {%- endif -%}

    <div class="trust-badges-bar__grid trust-badges-bar__grid--mobile-{{ section.settings.columns_mobile }}" style="--columns-desktop: {{ section.settings.columns_desktop }};">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="trust-badges-bar__item" {{ block.shopify_attributes }}>
            {%- if block.settings.custom_icon_image != blank -%}
              <div class="trust-badges-bar__icon-wrapper">
                {{ block.settings.custom_icon_image | image_url: width: 100 | image_tag: class: 'trust-badges-bar__custom-image', loading: 'lazy' }}
              </div>
            {%- elsif block.settings.icon != 'none' -%}
              <div class="trust-badges-bar__icon-wrapper">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751A11.959 11.959 0 0112 2.714z" />
                    </svg>
                  {%- else -%}
                    {% render 'icon-accordion', icon: block.settings.icon %}
                {%- endcase -%}
              </div>
            {%- endif -%}

            <div class="trust-badges-bar__content">
              {%- if block.settings.heading != blank -%}
                <div class="trust-badges-bar__heading">{{ block.settings.heading }}</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="trust-badges-bar__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </a>
        {%- else -%}
          <div class="trust-badges-bar__item" {{ block.shopify_attributes }}>
            {%- if block.settings.custom_icon_image != blank -%}
              <div class="trust-badges-bar__icon-wrapper">
                {{ block.settings.custom_icon_image | image_url: width: 100 | image_tag: class: 'trust-badges-bar__custom-image', loading: 'lazy' }}
              </div>
            {%- elsif block.settings.icon != 'none' -%}
              <div class="trust-badges-bar__icon-wrapper">
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751A11.959 11.959 0 0112 2.714z" />
                    </svg>
                  {%- else -%}
                    {% render 'icon-accordion', icon: block.settings.icon %}
                {%- endcase -%}
              </div>
            {%- endif -%}

            <div class="trust-badges-bar__content">
              {%- if block.settings.heading != blank -%}
                <div class="trust-badges-bar__heading">{{ block.settings.heading }}</div>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="trust-badges-bar__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.trust-badges-bar.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.heading_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.heading_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.heading_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.heading_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.trust-badges-bar.headers.layout.content"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.featured-collection.settings.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "t:sections.trust-badges-bar.settings.show_dividers.label",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "t:sections.trust-badges-bar.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.trust-badges-bar.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.trust-badges-bar.settings.columns_mobile.options__2.label"
        },
        {
          "value": "scroll",
          "label": "t:sections.trust-badges-bar.settings.columns_mobile.options__scroll.label"
        }
      ],
      "default": "2",
      "label": "t:sections.trust-badges-bar.settings.columns_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:sections.trust-badges-bar.settings.icon_color.label",
      "default": "#b8986a",
      "info": "t:sections.trust-badges-bar.settings.icon_color.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "t:sections.trust-badges-bar.blocks.badge.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.label",
          "options": [
            {
              "value": "none",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__1.label"
            },
            {
              "value": "truck",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__43.label"
            },
            {
              "value": "return",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__34.label"
            },
            {
              "value": "shield",
              "label": "t:sections.all.icons.shield.label"
            },
            {
              "value": "star",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__41.label"
            },
            {
              "value": "lock",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__22.label"
            },
            {
              "value": "box",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__5.label"
            },
            {
              "value": "check_mark",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__8.label"
            },
            {
              "value": "heart",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__16.label"
            },
            {
              "value": "plane",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__29.label"
            },
            {
              "value": "lightning_bolt",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__20.label"
            },
            {
              "value": "chat_bubble",
              "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.icon.options__7.label"
            }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "custom_icon_image",
          "label": "t:sections.trust-badges-bar.blocks.badge.settings.custom_icon_image.label",
          "info": "t:sections.trust-badges-bar.blocks.badge.settings.custom_icon_image.info"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Free Shipping",
          "label": "t:sections.trust-badges-bar.blocks.badge.settings.heading.label"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "On orders over $150",
