        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.trust-badges-bar.blocks.badge.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust-badges-bar.presets.name",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "truck",
            "heading": "Free Shipping",
            "text": "On orders over $150"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "return",
            "heading": "30-Day Returns",
            "text": "Hassle-free policy"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "shield",
            "heading": "Secure Checkout",
            "text": "256-bit encryption"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "star",
            "heading": "4.8\u2605 Rated",
            "text": "12,000+ reviews"
          }
        }
      ]
    }
  ]
}
{% endschema %}
