{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{{ 'multi-collection-tabs.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'multi-collection-tabs.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  
  .section-{{ section.id }}-tabs {
    --tab-image-size-mobile: {{ section.settings.tab_image_size_mobile }}px;
    --tab-image-size-desktop: {{ section.settings.tab_image_size }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient section-{{ section.id }}-tabs">
  <div class="collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}">
    
    {% render 'section-heading',
      title: section.settings.title,
      heading_size: section.settings.heading_size,
      heading_alignment: section.settings.heading_alignment,
      description: section.settings.description,
      description_style: section.settings.description_style,
      description_alignment: section.settings.heading_alignment,
      wrapper_classes: 'collection__title page-width'
    %}

    <multi-collection-tabs data-pagination-type="{{ section.settings.pagination_type }}" data-limit="{{ section.settings.products_limit }}">
      <div class="page-width">
        <ul class="multi-collection-tabs__list list-unstyled" role="tablist">
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection = block.settings.collection
              assign title = block.settings.title | default: collection.title | default: 'Collection'
              assign image = block.settings.image | default: collection.featured_image
            -%}
            <li class="multi-collection-tabs__item" role="presentation" {{ block.shopify_attributes }}>
              <button class="multi-collection-tabs__button{% if forloop.first %} active{% endif %}" data-url="{{ collection.url }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                <div class="multi-collection-tabs__image-wrapper shape--{{ section.settings.tab_image_shape }}">
                  {%- if image != blank -%}
                    {{ image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'multi-collection-tabs__image' }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg multi-collection-tabs__image' }}
                  {%- endif -%}
                </div>
                <span class="multi-collection-tabs__title">{{ title }}</span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="multi-collection-tabs__content">
        <div id="MultiCollectionGridContainer" class="multi-collection-tabs__pane active" style="position: relative;">
          {%- assign first_block = section.blocks.first -%}
          {%- assign first_collection = first_block.settings.collection -%}
          {%- if first_collection != blank and first_collection.all_products_count > 0 -%}
            <div class="product-grid-container" id="ProductGridContainer">
              <div class="collection page-width">
                <ul
                  id="product-grid"
                  data-id="main-collection-product-grid"
                  class="
                    grid product-grid grid--2-col-tablet-down
                    grid--4-col-desktop
                  "
                >
                  {%- for product in first_collection.products limit: section.settings.products_limit -%}
                    <li class="grid__item">
                      {% render 'card-product',
                        card_product: product,
                        media_aspect_ratio: 'adapt',
                        show_secondary_image: true,
                        section_id: section.id
                      %}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- elsif first_collection != blank and first_collection.all_products_count == 0 -%}
            <div id="ProductGridContainer">
              <div class="collection page-width center" style="padding: 4rem 0;">
                <p class="h3">{{ 'sections.collection_template.empty' | t | default: 'No products found' }}</p>
              </div>
            </div>
          {%- else -%}
            <div id="ProductGridContainer">
              <div class="collection page-width">
                <ul
                  id="product-grid"
                  data-id="main-collection-product-grid"
                  class="
                    grid product-grid grid--2-col-tablet-down
                    grid--4-col-desktop
                  "
                >
                  {%- for i in (1..section.settings.products_limit) -%}
                    <li class="grid__item">
                      {% render 'card-product',
                        show_vendor: false,
                        media_aspect_ratio: 'adapt',
                        section_id: section.id
                      %}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </multi-collection-tabs>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.multi-collection-tabs.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header.content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Featured Collections",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.all.heading_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.heading_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.heading_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.heading_alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "select",
      "id": "description_style",
      "label": "t:sections.featured-collection.settings.description_style.label",
      "options": [
        {
          "value": "body",
          "label": "t:sections.featured-collection.settings.description_style.options__1.label"
        },
        {
          "value": "subtitle",
          "label": "t:sections.featured-collection.settings.description_style.options__2.label"
        },
        {
          "value": "uppercase",
          "label": "t:sections.featured-collection.settings.description_style.options__3.label"
        }
      ],
      "default": "body"
    },
    {
      "type": "header",
      "content": "t:sections.multi-collection-tabs.headers.tab_styles.content"
    },
    {
      "type": "select",
      "id": "tab_image_shape",
      "label": "t:sections.multi-collection-tabs.settings.tab_image_shape.label",
      "options": [
        {
          "value": "circle",
          "label": "t:sections.multi-collection-tabs.settings.tab_image_shape.options__circle.label"
        },
        {
          "value": "rounded",
          "label": "t:sections.multi-collection-tabs.settings.tab_image_shape.options__rounded.label"
        },
        {
          "value": "square",
          "label": "t:sections.multi-collection-tabs.settings.tab_image_shape.options__square.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.multi-collection-tabs.settings.tab_image_shape.options__landscape.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multi-collection-tabs.settings.tab_image_shape.options__portrait.label"
        }
      ],
      "default": "circle"
    },
    {
      "type": "range",
      "id": "tab_image_size",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.multi-collection-tabs.settings.tab_image_size.label",
      "default": 90
    },
    {
      "type": "range",
      "id": "tab_image_size_mobile",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "t:sections.multi-collection-tabs.settings.tab_image_size_mobile.label",
      "default": 70
    },
    {
      "type": "header",
      "content": "t:sections.multi-collection-tabs.headers.grid_pagination.content"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "label": "t:sections.multi-collection-tabs.settings.pagination_type.label",
      "options": [
        {
          "value": "pages",
          "label": "t:sections.multi-collection-tabs.settings.pagination_type.options__pages.label"
        },
        {
          "value": "load_more",
          "label": "t:sections.multi-collection-tabs.settings.pagination_type.options__load_more.label"
        },
        {
          "value": "infinite",
          "label": "t:sections.multi-collection-tabs.settings.pagination_type.options__infinite.label"
        },
        {
          "value": "none",
          "label": "t:sections.multi-collection-tabs.settings.pagination_type.options__none.label"
        }
      ],
      "default": "load_more"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 36,
      "step": 4,
      "default": 8,
      "label": "t:sections.multi-collection-tabs.settings.products_limit.label"
    },
    {
      "type": "header",
      "content": "t:sections.multi-collection-tabs.headers.layout_colors.content"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.featured-collection.settings.full_width.label",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.multi-collection-tabs.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.multi-collection-tabs.blocks.collection.settings.collection.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multi-collection-tabs.blocks.collection.settings.image.label",
          "info": "t:sections.multi-collection-tabs.blocks.collection.settings.image.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.multi-collection-tabs.blocks.collection.settings.title.label",
          "info": "t:sections.multi-collection-tabs.blocks.collection.settings.title.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multi-collection-tabs.presets.name",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
