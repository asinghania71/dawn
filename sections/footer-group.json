{
  "name": "t:sections.footer.name",
  "type": "footer",
  "sections": {
    "footer": {
      "type": "footer",
      "blocks": {
        "footer-0": {
          "type": "link_list",
          "settings": {
            "heading": "Quick links",
            "menu": "footer"
          }
        },
        "footer-1": {
          "type": "link_list",
          "settings": {
            "heading": "Info",
            "menu": "footer"
          }
        },
        "footer-2": {
          "type": "text",
          "settings": {
            "heading": "Our mission",
            "subtext": "<p>Share contact information, store details, and brand content with your customers.<\/p>"
          }
        }
      },
      "block_order": [
        "footer-0",
        "footer-1",
        "footer-2"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "newsletter_enable": true,
        "newsletter_heading": "Subscribe to our emails",
        "show_social": true,
        "enable_country_selector": false,
        "enable_language_selector": false,
        "payment_enable": true,
        "show_policy": false,
        "margin_top": 48,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "sticky-bottom-nav": {
      "type": "sticky-bottom-nav",
      "blocks": {
        "nav_1": {
          "type": "link",
          "settings": {
            "text": "Home",
            "url": "/",
            "action_type": "link",
            "icon": "home"
          }
        },
        "nav_2": {
          "type": "link",
          "settings": {
            "text": "Search",
            "url": "/search",
            "action_type": "search",
            "icon": "search"
          }
        },
        "nav_3": {
          "type": "link",
          "settings": {
            "text": "Shop",
            "url": "shopify:\/\/collections\/all",
            "action_type": "link",
            "icon": "box"
          }
        },
        "nav_4": {
          "type": "link",
          "settings": {
            "text": "Saved",
            "url": "/search?view=wishlist",
            "action_type": "wishlist",
            "icon": "heart"
          }
        },
        "nav_5": {
          "type": "link",
          "settings": {
            "text": "Bag",
            "url": "/cart",
            "action_type": "cart",
            "icon": "cart"
          }
        }
      },
      "block_order": [
        "nav_1",
        "nav_2",
        "nav_3",
        "nav_4",
        "nav_5"
      ],
      "settings": {
        "design_style": "classic",
        "color_scheme": "scheme-1"
      }
    },
    "custom-badges-config": {
      "type": "custom-badges-config",
      "blocks": {
        "badge_1": {
          "type": "badge",
          "settings": {
            "trigger_tag": "badge:bestseller",
            "display_text": "Best Seller",
            "emoji": "🔥",
            "color_scheme": "scheme-4"
          }
        },
        "badge_2": {
          "type": "badge",
          "settings": {
            "trigger_tag": "badge:new",
            "display_text": "New Arrival",
            "emoji": "✨",
            "color_scheme": "scheme-5"
          }
        }
      },
      "block_order": [
        "badge_1",
        "badge_2"
      ],
      "settings": {
        "position": "top-left",
        "size": "medium"
      }
    }
  },
  "order": [
    "footer",
    "sticky-bottom-nav",
    "custom-badges-config"
  ]
}
