{{ 'quick-order-list.css' | asset_url | stylesheet_tag }}

<script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>

{% render 'quick-order-list', product: product, show_image: section.settings.show_image, show_sku: section.settings.show_sku, is_modal: true %}

{% schema %}
{
  "name": "t:sections.quick-order-list.name",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-product.blocks.share.settings.show_share_label.label"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "default": true,
      "label": "t:sections.main-product.blocks.sku.name"
    }
  ]
}
{% endschema %}

