{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "blocks": {
        "countdown": {
          "type": "countdown",
          "settings": {
            "text": "Flash Sale ends in:",
            "end_date": "2026-12-31",
            "end_time": "23:59"
          }
        },
        "cart_goal": {
          "type": "cart_goal",
          "settings": {
            "threshold": 100,
            "progress_text": "You are [amount] away from Free Shipping",
            "success_text": "You unlocked Free Shipping!",
            "text_color": "#ffffff",
            "success_color": "#22c55e"
          }
        },
        "announcement": {
          "type": "announcement",
          "settings": {
            "text": "Welcome to our Premium Store",
            "text_alignment": "center",
            "color_scheme": "scheme-1"
          }
        }
      },
      "block_order": [
        "countdown",
        "cart_goal",
        "announcement"
      ],
      "settings": {
        "color_scheme": "scheme-4",
        "show_line_separator": true,
        "header_separator_color": "rgba(255,255,255,0.1)",
        "dismissible": true,
        "display_mode": "slider",
        "auto_rotate": true,
        "slider_speed": 4
      }
    },
    "header": {
      "type": "header",
      "blocks": {
        "mega_1": {
          "type": "mega_menu",
          "settings": {
            "nav_handle": "catalog",
            "show_column_images": true,
            "promo_heading": "Summer Collection",
            "promo_subtext": "Explore the latest arrivals for this season.",
            "promo_cta": "Shop Now",
            "promo_link": "shopify://collections/all"
          }
        }
      },
      "block_order": [
        "mega_1"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "logo_position": "middle-left",
        "menu": "main-menu",
        "menu_type_desktop": "mega",
        "sticky_header_type": "on-scroll-up",
        "show_line_separator": true,
        "enable_country_selector": true,
        "enable_language_selector": true,
        "mobile_logo_position": "center",
        "margin_bottom": 0,
        "padding_top": 20,
        "padding_bottom": 20
      }
    }
  },
  "order": [
    "announcement-bar",
    "header"
  ]
}