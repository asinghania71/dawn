{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'section-scrolling-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% if section.settings.image_height == 'small' %}
    #ScrollingBanner-{{ section.id }} .scrolling-banner-section {
      --section-banner-height: 42rem;
      --section-banner-height-mobile: 28rem;
    }
  {% elsif section.settings.image_height == 'medium' %}
    #ScrollingBanner-{{ section.id }} .scrolling-banner-section {
      --section-banner-height: 56rem;
      --section-banner-height-mobile: 34rem;
    }
  {% elsif section.settings.image_height == 'large' %}
    #ScrollingBanner-{{ section.id }} .scrolling-banner-section {
      --section-banner-height: 72rem;
      --section-banner-height-mobile: 39rem;
    }
  {% elsif section.settings.image_height == 'viewport' %}
    #ScrollingBanner-{{ section.id }} .scrolling-banner-section {
      --section-banner-height: 100vh;
      --section-banner-height-mobile: 100vh;
    }
  {% endif %}
  
  {%- for block in section.blocks -%}
    #Slide-{{ section.id }}-{{ forloop.index }}::after {
      opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
    }
  {%- endfor -%}
{%- endstyle -%}

<div id="ScrollingBanner-{{ section.id }}" class="scrolling-banner-container">
  <div class="scrolling-banner-section">
    <div class="scrolling-banner__track">
      {%- for block in section.blocks -%}
        <div id="Slide-{{ section.id }}-{{ forloop.index }}" class="scrolling-banner__item banner" {{ block.shopify_attributes }}>
          
          {%- if block.settings.image != blank -%}
            <div class="banner__media media">
              {{ block.settings.image | image_url: width: 3840 | image_tag: loading: 'lazy', class: 'banner__media-image', widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840' }}
            </div>
          {%- else -%}
            <div class="banner__media media placeholder">
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          <div class="banner__content banner__content--{{ block.settings.desktop_content_position }} page-width">
            <div class="banner__box content-container color-{{ block.settings.color_scheme }} gradient">
              {%- if block.settings.heading != blank -%}
                <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }}">
                  {{ block.settings.heading }}
                </h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="banner__text rte">
                  <p>{{ block.settings.text }}</p>
                </div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="banner__buttons">
                  <a {% if block.settings.button_link == blank %} role="link" aria-disabled="true" {% else %} href="{{ block.settings.button_link }}" {% endif %} class="button button--primary">
                    {{ block.settings.button_label | escape }}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>

        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.scrolling-banner.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "small",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "viewport",
          "label": "t:sections.scrolling-banner.settings.image_height.options__viewport.label"
        }
      ],
      "default": "viewport",
      "label": "t:sections.scrolling-banner.settings.image_height.label"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "t:sections.scrolling-banner.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.scrolling-banner.blocks.slide.settings.image.label"
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "t:sections.scrolling-banner.blocks.slide.settings.image_overlay_opacity.label",
          "default": 0
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.all.colors.label",
          "default": "scheme-1"
        },
        {
          "type": "select",
          "id": "desktop_content_position",
          "options": [
            {
              "value": "top-left",
              "label": "t:sections.image-banner.settings.desktop_content_position.options__1.label"
            },
            {
              "value": "top-center",
              "label": "t:sections.image-banner.settings.desktop_content_position.options__2.label"
            },
            {
              "value": "top-right",
              "label": "t:sections.image-banner.settings.desktop_content_position.options__3.label"
            },
            {
              "value": "middle-left",
              "label": "t:sections.image-banner.settings.desktop_content_position.options__4.label"
            },
            {
              "value": "middle-center",
              "label": "t:sections.image-banner.settings.desktop_content_position.options__5.label"
            },
            {
              "value": "middle-right",
              "label": "t:sections.image-banner.settings.desktop_content_position.options__6.label"
            },
            {
              "value": "bottom-left",
              "label": "t:sections.image-banner.settings.desktop_content_position.options__7.label"
            },
            {
              "value": "bottom-center",
              "label": "t:sections.image-banner.settings.desktop_content_position.options__8.label"
            },
            {
              "value": "bottom-right",
              "label": "t:sections.image-banner.settings.desktop_content_position.options__9.label"
            }
          ],
          "default": "middle-center",
          "label": "t:sections.scrolling-banner.blocks.slide.settings.desktop_content_position.label"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Image banner",
          "label": "t:sections.scrolling-banner.blocks.slide.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.scrolling-banner.blocks.slide.settings.heading_size.label"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Give customers details about the banner image(s) or content on the template.",
          "label": "t:sections.scrolling-banner.blocks.slide.settings.text.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.scrolling-banner.blocks.slide.settings.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.scrolling-banner.blocks.slide.settings.button_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.scrolling-banner.presets.name",
      "settings": {
        "image_height": "viewport"
      },
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "heading": "Premium Quality"
          }
        },
        {
          "type": "banner",
          "settings": {
            "heading": "Free Shipping"
          }
        },
        {
          "type": "banner",
          "settings": {
            "heading": "Secure Checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
