lank\" class=\"logo-bar__link\">\n            <img src=\"\/\/cdn.shopify.com\/s\/files\/1\/0465\/2636\/5846\/files\/ajio_160x160@2x.png?v=1597833974\" alt=\"Tusok also available on ajio.com\" class=\"logo-bar__image\">\n          \n              <\/a>\n        <\/li>\n         {% endif %}\n      <\/ul>\n      <\/div> <br>  {% endif %}"
