{% comment %}
  Renders custom floating ribbon badges on product images.
  Accepts:
  - product: {Object} Product Liquid object
{% endcomment %}

{%- if product != blank -%}
  {{ 'component-product-ribbons.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-ribbons.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="product-ribbons-wrapper">
  <custom-product-ribbon
    data-tags="{{ product.tags | join: ',' | escape | downcase }}"
    data-rating="{{ product.metafields.reviews.rating.value | round: 1 | default: 0 }}"
    data-inventory="{{ product.first_available_variant.inventory_quantity | default: 0 }}"
    data-price="{{ product.price | default: 0 }}"
    data-compare-at-price="{{ product.compare_at_price | default: product.price }}"
    data-vendor="{{ product.vendor | escape | downcase }}"
    data-type="{{ product.type | escape | downcase }}"
    data-title="{{ product.title | escape | downcase }}"
    data-created-at="{{ product.created_at }}"
    {% if ribbon_size %} data-size="{{ ribbon_size }}"{% endif %}
  ></custom-product-ribbon>
</div>
