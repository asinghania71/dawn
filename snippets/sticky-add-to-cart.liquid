{{ 'component-sticky-add-to-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sticky-add-to-cart.js' | asset_url }}" defer="defer"></script>

<sticky-add-to-cart class="sticky-add-to-cart color-{{ section.settings.color_scheme }} gradient sticky-add-to-cart--{{ section.settings.sticky_add_to_cart_position | downcase }}" data-form-id="product-form-{{ section.id }}">
  <div class="page-width sticky-add-to-cart__inner">
    <div class="sticky-add-to-cart__info">
      {%- if product.featured_media -%}
        <img src="{{ product.featured_media | image_url: width: 60 }}" alt="{{ product.featured_media.alt | escape }}" class="sticky-add-to-cart__image" loading="lazy" width="60" height="{{ 60 | divided_by: product.featured_media.preview_image.aspect_ratio | ceil }}">
      {%- endif -%}
      <div class="sticky-add-to-cart__details">
        <h3 class="sticky-add-to-cart__title">{{ product.title | escape }}</h3>
        <div class="sticky-add-to-cart__price" id="Sticky-Price-{{ section.id }}">
           {% render 'price', product: product, use_variant: true, show_badges: false %}
        </div>
      </div>
    </div>
    
    <div class="sticky-add-to-cart__action">
      <button type="button" class="button button--primary sticky-add-to-cart__button">
        <span>
          {%- if product.selected_or_first_available_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
        <div class="loading-overlay__spinner hidden">
          <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
          </svg>
        </div>
      </button>
    </div>
  </div>
</sticky-add-to-cart>
